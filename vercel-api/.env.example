# OpenRouteService API key — https://account.heigit.org/
# Free tier hard-fails with 429 rather than billing, which is the whole reason
# it replaced Google Maps here.
ORS_API_KEY=

# Upstash Redis, for the global monthly call counter.
# `vercel install upstash` injects the KV_REST_API_* pair automatically; the
# UPSTASH_REDIS_REST_* pair is accepted too if you provision by hand.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional overrides
#
# Free-tier limits, read from this account's own x-ratelimit-* response headers
# on 2026-08-21 (not from the docs — the headers are authoritative per key):
#
#   /geocode/search      1000 requests / day
#   /v2/directions/*     2000 requests / day
#
# Both reset on a ~24h rolling window. Note they are DAILY while the counter
# here is MONTHLY, and that geocoding binds first: one /direction spends two
# geocodes and one route, so the real ceiling is ~500 directions per day, hit
# on the geocoding quota while the directions quota is still three-quarters
# unused. A /location spends one geocode, so ~1000 per day.
#
# 1000/month averages ~33/day and is therefore safe in steady state, but does
# not prevent a burst: spend it all in one day and ORS starts answering 429
# around request 500, which surfaces as QUOTA_EXCEEDED rather than as this
# cap being reached. That fails safe — it costs nothing — but the message the
# user sees is about the provider, not about us.
# CLIP_MAX_MONTHLY_CALLS=1000
# CLIP_ORS_TIMEOUT_MS=8000
# CLIP_AUTH0_TIMEOUT_MS=5000

# Local development only: skip the counter entirely when there's no Redis to
# talk to. Never set this on a deployment — the cap is what protects the free
# tier, and the service refuses to fail open without it.
# CLIP_DISABLE_QUOTA=1
