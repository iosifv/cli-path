{
  "name": "clip-vercel-api",
  "version": "0.1.0",
  "description": "API tier for cli-path, hosted on Vercel and backed by OpenRouteService",
  "author": "iosifv",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vercel dev",
    "deploy": "vercel deploy",
    "deploy-prod": "vercel deploy --prod",
    "test": "vitest run",
    "test-watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.ts\""
  },
  "dependencies": {
    "@upstash/redis": "^1.38.3",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@vercel/node": "^7.0.0",
    "json-schema-to-ts": "^3.1.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
